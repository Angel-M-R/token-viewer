{
  "name": "tokenviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:collector": "pnpm --filter collector dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validate:snapshots": "tsx packages/core/src/validate-snapshots-cli.ts snapshots",
    "validate:snapshot-fixtures": "tsx packages/core/src/validate-snapshots-cli.ts scripts/fixtures/snapshots",
    "ci:check-snapshot-publication": "tsx scripts/ci/snapshot-policy.ts publication",
    "ci:check-snapshot-budget": "tsx scripts/ci/snapshot-policy.ts budget snapshots scripts/fixtures/snapshots",
    "test:ci-snapshots": "vitest run scripts/ci/snapshot-policy.test.ts",
    "typecheck:ci-snapshots": "tsc -p scripts/ci/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
