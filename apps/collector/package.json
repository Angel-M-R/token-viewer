{
  "name": "collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tokenviewer-collector": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "node scripts/link-bin.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "publish": "tsx src/cli.ts run --publish"
  },
  "dependencies": {
    "@tokenviewer/adapters": "workspace:*",
    "@tokenviewer/core": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
